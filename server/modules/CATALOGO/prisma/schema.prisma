// ============================================================
//  COTIZADOR API - PRISMA SCHEMA
//  Sistema de costeo y catálogo de telas para confección
//
//  Contiene:
//    1. colecciones          - líneas de tela (SUPERNOVA, DRAGONFLY...)
//    2. telas                - cada variante/color individual
//    3. tipos_prenda         - JACKET, 2 PIECES, 3 PIECES, TROUSERS, VEST
//    4. cotizaciones        - historial de cotizaciones realizadas
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // ⚠️ IMPORTANTE: Usa la MISMA base de datos del servidor principal
  // Estas tablas se agregarán a la BD existente (neondb)
  // No se crearán tablas nuevas ni se modificarán las existentes (Usuario, Contenido, etc.)
  url      = env("DATABASE_URL")
}

// ============================================================
//  ENUMS
// ============================================================

enum Disponibilidad {
  disponible      // Disponible inmediatamente
  agotado         // Sin stock temporal
  por_pedido      // Se puede pedir pero no hay stock
  descontinuado   // Ya no se produce
}

enum TipoManufactura {
  bespoke        // Confección a medida completa
  industrial     // Producción estándar
}

// ============================================================
//  1. COLECCIONES
//     Línea o colección de tela (ej. "SUPERNOVA", "DRAGONFLY")
// ============================================================

model Coleccion {
  id_coleccion      Int      @id @default(autoincrement())
  nombre            String   @db.VarChar(100)     // "SUPERNOVA", "DRAGONFLY"
  proveedor         String?  @db.VarChar(100)      // Opcional: nombre del proveedor
  descuento_default Decimal  @default(0) @db.Decimal(5, 2) // 0.35 = 35% descuento típico

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relaciones
  telas             Tela[]

  @@index([nombre])
  @@index([proveedor])
  @@map("colecciones")
}

// ============================================================
//  2. TELAS
//     Cada variante/color específico dentro de una colección
//     (ej. SUPERNOVA 1425000-025, SUPERNOVA 1425100-116...)
// ============================================================

model Tela {
  id_tela           Int              @id @default(autoincrement())
  id_coleccion      Int
  codigo            String           @db.VarChar(50)      // "1425000-025"
  color             String?          @db.VarChar(100)      // Nombre del color/patrón
  precio_por_yarda  Decimal          @db.Decimal(10, 2)   // Precio de lista por yarda
  descuento         Decimal          @default(0) @db.Decimal(5, 2)  // 0.35 = 35%
  precio_neto       Decimal          @db.Decimal(10, 2)   // Computed: precio_por_yarda * (1 - descuento)
  disponibilidad    Disponibilidad   @default(disponible)
  visible_publico   Boolean          @default(true)      // true = visible en catálogo clientes

  // Timestamps
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relaciones
  coleccion         Coleccion        @relation(fields: [id_coleccion], references: [id_coleccion], onDelete: Restrict)
  cotizaciones      Cotizacion[]

  // Constraints
  @@unique([id_coleccion, codigo])   // No puede haber código duplicado en misma colección
  @@index([codigo])
  @@index([disponibilidad])
  @@index([visible_publico])
  @@index([color])
  @@map("telas")
}

// ============================================================
//  3. TIPOS DE PRENDA
//     Costos fijos y yardaje requerido por tipo de prenda
// ============================================================

model TipoPrenda {
  id_tipo_prenda     Int      @id @default(autoincrement())
  nombre             String   @unique @db.VarChar(50)  // "JACKET", "2 PIECES", "3 PIECES", "TROUSERS", "VEST"
  codigo             String   @unique @db.VarChar(20)   // Código corto: "jacket", "2-piece", etc.

  // Yardaje y costos
  yardas_requeridas  Decimal  @db.Decimal(5, 2)         // Yardas necesarias: 2.5, 4, 5, 2, 1.75
  costo_manufactura   Decimal  @db.Decimal(10, 2)       // Costo fijo de mano de obra
  costo_envio         Decimal  @db.Decimal(10, 2)       // Costo fijo de envío
  costo_forro         Decimal  @default(0) @db.Decimal(10, 2)  // Costo del forro (opcional)
  markup              Decimal  @default(3) @db.Decimal(5, 2)    // 3.0 = 300% markup

  // Timestamps
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relaciones
  cotizaciones       Cotizacion[]

  @@index([codigo])
  @@map("tipos_prenda")
}

// ============================================================
//  4. COTIZACIONES
//     Historial de cotizaciones realizadas por usuarios
// ============================================================

model Cotizacion {
  id_cotizacion     Int              @id @default(autoincrement())
  id_tela           Int
  id_tipo_prenda    Int
  tipo_manufactura  TipoManufactura  @default(bespoke)

  // Datos calculados (se guardan como snapshot)
  precio_calculado   Decimal          @db.Decimal(12, 2)
  costo_tela         Decimal          @db.Decimal(10, 2)
  gastos_fijos       Decimal          @db.Decimal(10, 2)
  markup_aplicado    Decimal          @db.Decimal(5, 2)
  yardas_usadas      Decimal          @db.Decimal(5, 2)

  // Usuario que realizó la cotización (opcional si no hay auth)
  usuario_email      String?          @db.VarChar(255)
  usuario_nombre     String?          @db.VarChar(255)

  // Timestamps
  createdAt          DateTime         @default(now())

  // Relaciones
  tela               Tela             @relation(fields: [id_tela], references: [id_tela])
  tipo_prenda        TipoPrenda       @relation(fields: [id_tipo_prenda], references: [id_tipo_prenda])

  @@index([usuario_email])
  @@index([createdAt])
  @@index([id_tela])
  @@map("cotizaciones")
}

// ============================================================
//  MULTIPLICADORES (para compatibilidad con sistema anterior)
//     Estos valores sobreescriben los de TipoPrenda si existen
//     Se usa para ajustes rápidos sin modificar tipos de prenda
// ============================================================

model Multiplicador {
  id                 Int              @id @default(autoincrement())
  tipo_manufactura   TipoManufactura
  tipo_prenda_codigo String           @db.VarChar(20)  // Referencia a TipoPrenda.codigo

  // Multiplicador que sobreescribe al TipoPrenda.markup
  valor              Decimal          @db.Decimal(5, 2)

  // Timestamps
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([tipo_manufactura, tipo_prenda_codigo])
  @@index([tipo_manufactura])
  @@index([tipo_prenda_codigo])
  @@map("multiplicadores")
}
